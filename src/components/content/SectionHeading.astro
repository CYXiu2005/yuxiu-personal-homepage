---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props as Props;
---

<div class="mb-5 space-y-2">
  {eyebrow && <p class="text-xs font-medium uppercase tracking-[0.24em] text-[color:var(--muted)]">{eyebrow}</p>}
  <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  {description && <p class="max-w-2xl text-sm leading-6 text-[color:var(--muted)] sm:text-base">{description}</p>}
</div>