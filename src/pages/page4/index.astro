  <dialog class="wechat-dialog" id="wechat-dialog" aria-labelledby="wechat-dialog-title">
    <button class="wechat-dialog__close" id="wechat-dialog-close" type="button" aria-label="关闭">×</button>
    <img class="wechat-dialog__qr" src="/images/page1/page1-ma.webp" alt="云岫 clouds seeping 公众号二维码" />
    <p class="wechat-dialog__name" id="wechat-dialog-title">公众号：云岫 clouds seeping</p>
    <p class="wechat-dialog__copy-row">
      <button class="wechat-dialog__copy" id="wechat-link-copy" type="button" data-copy="https://mp.weixin.qq.com/mp/profile_ext?action=home&amp;__biz=MzYzOTAwNzI1Mg==#wechat_redirect">复制链接</button>
      <span>（需要在微信中打开）</span>
    </p>
  </dialog>

  <script define:vars={{ writings }}>
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const frames = [...document.querySelectorAll('.background-frame')];
    let frameIndex = 0;
    if (!reduceMotion.matches && frames.length > 1) setInterval(() => {
      frames[frameIndex].classList.remove('active'); frameIndex = (frameIndex + 1) % frames.length; frames[frameIndex].classList.add('active');
    }, 750);

    let type = 'poetry'; let index = 0;
    const q = (selector) => document.querySelector(selector);
    function render(animate = true) {
      const item = writings[type][index];
      q('.paper-board').classList.toggle('poetry-mode', type === 'poetry');
      q('#category-cn').textContent = type === 'poetry' ? '诗' : '文';
      q('#category-en').textContent = type === 'poetry' ? 'POETRY' : 'PROSE';
      q('#counter').textContent = `${String(index + 1).padStart(2, '0')} / ${String(writings[type].length).padStart(2, '0')}`;
      q('#meta').textContent = item.meta; q('#article-title').textContent = item.title; q('#excerpt').textContent = item.excerpt;
      q('#body-copy').textContent = item.body;
      q('.article-copy').scrollTop = 0;
      q('.more-poetry').hidden = type !== 'poetry';
      q('.more-wechat').hidden = type !== 'prose';
      const dots = q('#dots'); dots.innerHTML = writings[type].map((_, i) => `<button class="dot ${i === index ? 'active' : ''}" data-index="${i}" aria-label="第 ${i + 1} 篇"></button>`).join('');
      dots.querySelectorAll('.dot').forEach((dot) => dot.addEventListener('click', () => { index = Number(dot.dataset.index); render(); }));
      if (animate && !reduceMotion.matches) { const card = q('#writing-card'); card.classList.remove('turning'); void card.offsetWidth; card.classList.add('turning'); }
    }
    document.querySelectorAll('.scroll-tab').forEach((button) => button.addEventListener('click', () => {
      type = button.dataset.type; index = 0;
      document.querySelectorAll('.scroll-tab').forEach((tab) => { const active = tab === button; tab.classList.toggle('active', active); tab.setAttribute('aria-pressed', String(active)); }); render();
    }));
    q('#previous').addEventListener('click', () => { index = (index - 1 + writings[type].length) % writings[type].length; render(); });
    q('#next').addEventListener('click', () => { index = (index + 1) % writings[type].length; render(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') q('#previous').click(); if (event.key === 'ArrowRight') q('#next').click(); });
    document.querySelectorAll('.verse-line span').forEach((char) => char.addEventListener('pointerenter', () => {
      if (reduceMotion.matches) return;
      char.classList.remove('char-ripple'); void char.offsetWidth; char.classList.add('char-ripple');
    }));
    const board = q('.paper-board');
    if (board && !reduceMotion.matches) {
      board.addEventListener('pointermove', (event) => {
        const rect = board.getBoundingClientRect();
        const rotateY = ((event.clientX - rect.left) / rect.width - .5) * 2.4;
        const rotateX = (.5 - (event.clientY - rect.top) / rect.height) * 1.7;
        board.style.setProperty('--tilt-x', `${rotateX}deg`);
        board.style.setProperty('--tilt-y', `${rotateY}deg`);
      });
      board.addEventListener('pointerleave', () => {
        board.style.setProperty('--tilt-x', '0deg');
        board.style.setProperty('--tilt-y', '0deg');
      });
    }
    const wechatDialog = q('#wechat-dialog');
    const wechatDialogOpen = q('#wechat-dialog-open');
    const wechatDialogClose = q('#wechat-dialog-close');
    const wechatLinkCopy = q('#wechat-link-copy');
    wechatDialogOpen?.addEventListener('click', () => wechatDialog?.showModal());
    wechatDialogClose?.addEventListener('click', () => wechatDialog?.close());
    wechatDialog?.addEventListener('click', (event) => { if (event.target === wechatDialog) wechatDialog.close(); });
    wechatLinkCopy?.addEventListener('click', async () => {
      const link = wechatLinkCopy.dataset.copy;
      if (!link) return;
      try {
        await navigator.clipboard.writeText(link);
        wechatLinkCopy.textContent = '已复制';
        setTimeout(() => { wechatLinkCopy.textContent = '复制链接'; }, 1600);
      } catch { window.prompt('请复制公众号链接', link); }
    });
    render(false);
  </script>
</body>
