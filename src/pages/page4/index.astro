<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Yuxiu 的诗与文" />
  <link rel="stylesheet" href="/fonts/pingfang-gongzi/result.css" />
  <link rel="stylesheet" href="/fonts/shangtudongguan-bold/result.css" />
