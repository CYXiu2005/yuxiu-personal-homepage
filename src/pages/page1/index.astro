  <script>
    (() => {
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      );

      /* -----------------------------------------------
         三帧背景动画
         ----------------------------------------------- */

      const frames = Array.from(
        document.querySelectorAll<HTMLImageElement>(".background-frame")
      );

      let activeFrame = 0;
      let frameTimer: number | undefined;
      const frameInterval = 750;

      const showFrame = (index: number) => {
        frames.forEach((frame, frameIndex) => {
          frame.classList.toggle(
            "is-active",
            frameIndex === index
          );
        });
      };

      const startFrames = () => {
        if (
          reduceMotion.matches ||
          frameTimer ||
          frames.length < 2
        ) {
          return;
        }

        frameTimer = window.setInterval(() => {
          activeFrame = (activeFrame + 1) % frames.length;
          showFrame(activeFrame);
        }, frameInterval);
      };

      const stopFrames = () => {
        if (!frameTimer) return;
        window.clearInterval(frameTimer);
        frameTimer = undefined;
      };

      Promise.all(
        frames.map((frame) =>
          frame.decode
            ? frame.decode().catch(() => undefined)
            : Promise.resolve()
        )
      ).finally(startFrames);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          stopFrames();
        } else {
          startFrames();
        }
      });

      /* -----------------------------------------------
         微信公众号二维码弹窗
         ----------------------------------------------- */

      const wechatDialog =
        document.querySelector<HTMLDialogElement>("#wechat-dialog");
      const wechatDialogOpen =
        document.querySelector<HTMLButtonElement>("#wechat-dialog-open");
      const wechatDialogClose =
        document.querySelector<HTMLButtonElement>("#wechat-dialog-close");
      const wechatLinkCopy =
        document.querySelector<HTMLButtonElement>("#wechat-link-copy");
      const wechatQr =
        document.querySelector<HTMLImageElement>(".wechat-dialog__qr");

      wechatDialogOpen?.addEventListener("click", () => {
        wechatDialog?.showModal();
      });

      wechatDialogClose?.addEventListener("click", () => {
        wechatDialog?.close();
      });

      wechatDialog?.addEventListener("click", (event) => {
        if (event.target === wechatDialog) {
          wechatDialog.close();
        }
      });

      wechatLinkCopy?.addEventListener("click", async () => {
        const link = wechatLinkCopy.dataset.copy;
        if (!link) return;

        try {
          await navigator.clipboard.writeText(link);
          wechatLinkCopy.textContent = "已复制";
          window.setTimeout(() => {
            wechatLinkCopy.textContent = "复制链接";
          }, 1600);
        } catch {
          window.prompt("请复制公众号链接", link);
        }
      });

      if (wechatQr && !reduceMotion.matches) {
        wechatQr.addEventListener("pointermove", (event) => {
          const rect = wechatQr.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          const rotateY = (x - .5) * 7;
          const rotateX = (.5 - y) * 7;

          wechatQr.style.transform =
            `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        wechatQr.addEventListener("pointerleave", () => {
          wechatQr.style.transform =
            "perspective(800px) rotateX(0deg) rotateY(0deg)";
        });
      }

      /* -----------------------------------------------
         明信片轻微倾斜
         ----------------------------------------------- */

      const postcard = document.querySelector<HTMLElement>("#profile-postcard");

      if (postcard && !reduceMotion.matches) {
        postcard.addEventListener("pointermove", (event) => {
          const rect = postcard.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;

          const rotateY = (x - 0.5) * 2.4;
          const rotateX = (0.5 - y) * 1.7;

          postcard.style.transform =
            `perspective(1100px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        postcard.addEventListener("pointerleave", () => {
          postcard.style.transform =
            "perspective(1100px) rotateX(0deg) rotateY(0deg)";
        });
      }

      /* -----------------------------------------------
         蝴蝶：鼠标靠近明信片时翻飞
         ----------------------------------------------- */

      const butterfly = document.querySelector<HTMLElement>("#butterfly");

      if (!postcard || !butterfly || reduceMotion.matches) {
        return;
      }

      const postcardElement = postcard;
      const butterflyElement = butterfly;

      const state = {
        x: window.innerWidth * 0.5,
        y: window.innerHeight * 0.5,
        targetX: window.innerWidth * 0.5,
        targetY: window.innerHeight * 0.5,
        pointerX: window.innerWidth * 0.5,
        pointerY: window.innerHeight * 0.5,
        visible: false,
        previousX: window.innerWidth * 0.5,
        previousY: window.innerHeight * 0.5,
        time: 0,
        facing: 1,
        headingTilt: 0
      };

      function distanceToRect(x: number, y: number, rect: DOMRect) {
        const nearestX = Math.max(
          rect.left,
          Math.min(x, rect.right)
        );

        const nearestY = Math.max(
          rect.top,
          Math.min(y, rect.bottom)
        );

        return Math.hypot(
          x - nearestX,
          y - nearestY
        );
      }

      window.addEventListener(
        "pointermove",
        (event) => {
          const pointerDeltaX = event.clientX - state.pointerX;

          if (pointerDeltaX > 1) state.facing = 1;
          if (pointerDeltaX < -1) state.facing = -1;

          state.pointerX = event.clientX;
          state.pointerY = event.clientY;

          const rect = postcardElement.getBoundingClientRect();
          const distance = distanceToRect(
            event.clientX,
            event.clientY,
            rect
          );

          state.visible = distance < 190;

          butterflyElement.classList.toggle(
            "is-visible",
            state.visible
          );
        },
        { passive: true }
      );

      function animateButterfly(timestamp: number) {
        state.time = timestamp * 0.001;

        if (state.visible) {
          const orbitX =
            Math.cos(state.time * 1.8) * 38 +
            Math.sin(state.time * .8) * 16;

          const orbitY =
            Math.sin(state.time * 2.1) * 17 -
            32;

          state.targetX = state.pointerX + orbitX;
          state.targetY = state.pointerY + orbitY;
        } else {
          const rect = postcardElement.getBoundingClientRect();

          state.targetX =
            rect.right - 54 +
            Math.cos(state.time * .95) * 18;

          state.targetY =
            rect.top + 54 +
            Math.sin(state.time * 1.1) * 14;
        }

        state.previousX = state.x;
        state.previousY = state.y;

        state.x += (state.targetX - state.x) * 0.05;
        state.y += (state.targetY - state.y) * 0.05;

        const velocityX = state.x - state.previousX;
        const velocityY = state.y - state.previousY;
        const speed = Math.hypot(velocityX, velocityY);

        if (speed > .08) {
          const targetTilt = Math.max(
            -58,
            Math.min(
              58,
              Math.atan2(velocityY, Math.abs(velocityX)) * 180 / Math.PI
            )
          );

          state.headingTilt +=
            (targetTilt - state.headingTilt) * .01;
        }

        const heading = 90 + state.headingTilt;

        const bob =
          Math.sin(state.time * 4) * 3;

        butterflyElement.style.transform =
          `translate3d(${state.x - 22}px, ${state.y - 17 + bob}px, 0)
           scale(${state.visible ? 0.67 : 0.55})
           scaleX(${state.facing})
           rotate(${heading}deg)`;

        window.requestAnimationFrame(animateButterfly);
      }

      window.requestAnimationFrame(animateButterfly);

      const secondButterfly = document.querySelector<HTMLElement>("#butterfly-second");

      if (secondButterfly) {
        const secondState = {
          x: window.innerWidth * .84,
          y: window.innerHeight * .55,
          targetX: window.innerWidth * .84,
          targetY: window.innerHeight * .55,
          previousX: window.innerWidth * .84,
          previousY: window.innerHeight * .55,
          velocityX: 0,
          velocityY: 0,
          facing: 1,
          pendingFacing: 1,
          directionChangedAt: 0,
          headingTilt: 0,
          nextWanderAt: 0
        };

        secondButterfly.classList.add("is-visible");

        const animateSecondButterfly = (timestamp: number) => {
          const time = timestamp * .001;

          if (timestamp >= secondState.nextWanderAt) {
            const regionCenterX = window.innerWidth * .865;
            const regionCenterY = window.innerHeight * .55;
            const horizontalRange = Math.min(105, window.innerWidth * .075);
            const verticalRange = Math.min(82, window.innerHeight * .095);

            secondState.targetX = regionCenterX
              + (Math.random() * 2 - 1) * horizontalRange;
            secondState.targetY = regionCenterY
              + (Math.random() * 2 - 1) * verticalRange;
            secondState.nextWanderAt = timestamp + 2300 + Math.random() * 2200;

            const nextFacing = secondState.targetX >= secondState.x ? 1 : -1;
            if (nextFacing !== secondState.pendingFacing) {
              secondState.pendingFacing = nextFacing;
              secondState.directionChangedAt = timestamp;
            }
          }

          if (
            secondState.facing !== secondState.pendingFacing &&
            timestamp - secondState.directionChangedAt > 280
          ) {
            secondState.facing = secondState.pendingFacing;
          }

          secondState.previousX = secondState.x;
          secondState.previousY = secondState.y;
          const isTurning = secondState.facing !== secondState.pendingFacing;
          const accelerationScale = isTurning ? .08 : 1;
          secondState.velocityX +=
            (secondState.targetX - secondState.x) * .00042 * accelerationScale;
          secondState.velocityY +=
            (secondState.targetY - secondState.y) * .00038 * accelerationScale;
          secondState.velocityX *= isTurning ? .88 : .965;
          secondState.velocityY *= isTurning ? .88 : .965;

          if (isTurning) {
            if (secondState.facing === 1 && secondState.velocityX < 0) {
              secondState.velocityX = 0;
            }
            if (secondState.facing === -1 && secondState.velocityX > 0) {
              secondState.velocityX = 0;
            }
          }

          const maxVelocity = 1.55;
          const velocityMagnitude = Math.hypot(
            secondState.velocityX,
            secondState.velocityY
          );
          if (velocityMagnitude > maxVelocity) {
            const velocityRatio = maxVelocity / velocityMagnitude;
            secondState.velocityX *= velocityRatio;
            secondState.velocityY *= velocityRatio;
          }

          secondState.x += secondState.velocityX;
          secondState.y += secondState.velocityY;

          const velocityX = secondState.velocityX;
          const velocityY = secondState.velocityY;
          if (Math.hypot(velocityX, velocityY) > .08) {
            const tilt = Math.max(-52, Math.min(52,
              Math.atan2(velocityY, Math.abs(velocityX)) * 180 / Math.PI
            ));
            secondState.headingTilt += (tilt - secondState.headingTilt) * .0045;
          }

          const bob = Math.sin(time * 2.35 + 1.7) * 3.6;
          secondButterfly.style.transform =
            `translate3d(${secondState.x - 22}px, ${secondState.y - 17 + bob}px, 0)
             scale(.62)
             scaleX(${secondState.facing})
             rotate(${90 + secondState.headingTilt}deg)`;

          window.requestAnimationFrame(animateSecondButterfly);
        };

        window.requestAnimationFrame(animateSecondButterfly);
      }
    })();
  </script>
</body>
</html>
