    willowBranches = awards.map((award, i) => {
      const [baseX, baseY, bend, curledTail] = awardWillows[i]; const direction = baseX < 490 ? -1 : 1;
      const chars = [...award]; const spacing = (chars.length > 27 ? 15.2 : 16.8) * sy;
      const nodes = chars.map((char, j) => {
        const progress = Math.min(j / 6, 1); const eased = 1 - (1 - progress) ** 2;
        const tailStart = Math.max(chars.length - 5, 7); const tp = curledTail && j >= tailStart ? (j - tailStart) / Math.max(chars.length - 1 - tailStart, 1) : 0;
        const te = tp * tp * (3 - 2 * tp); const ox = (baseX + direction * bend * eased + direction * 23 * te) * sx; const oy = (baseY + 15) * sy + j * spacing - 12 * sy * te;
        return { char, originalX:ox, originalY:oy, x:ox, y:oy, vx:0, vy:0, offsetX:0, offsetY:0, glow:0 };
      });
