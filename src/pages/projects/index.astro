  }));
  query('.close')?.addEventListener('click', () => dialog?.close()); dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); }); dialog?.addEventListener('close', () => { document.body.style.overflow = ''; last?.focus(); });
  const awardDialog = document.querySelector('#award-dialog'); const awardOpen = document.querySelector('#award-gallery-open'); const awardClose = document.querySelector('#award-dialog-close'); const awardCarousel = document.querySelector('#award-carousel');
  const awardCards = [...document.querySelectorAll('[data-award-index]')]; const awardDots = [...document.querySelectorAll('[data-award-dot]')]; const awardCounter = document.querySelector('.award-counter'); let awardFocus = 0; let awardDrag = null; let awardWheelTimer;
