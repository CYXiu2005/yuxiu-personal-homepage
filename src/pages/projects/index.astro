  const awardPrev = awardCarousel?.querySelector('.depth-carousel__arrow--prev'); const awardNext = awardCarousel?.querySelector('.depth-carousel__arrow--next');
  awardPrev?.addEventListener('pointerdown',(event)=>event.stopPropagation()); awardNext?.addEventListener('pointerdown',(event)=>event.stopPropagation()); awardPrev?.addEventListener('click',(event)=>{event.stopPropagation();setAwardFocus(awardFocus-1)}); awardNext?.addEventListener('click',(event)=>{event.stopPropagation();setAwardFocus(awardFocus+1)}); awardDots.forEach((dot)=>{dot.addEventListener('pointerdown',(event)=>event.stopPropagation());dot.addEventListener('click',(event)=>{event.stopPropagation();setAwardFocus(Number(dot.dataset.awardDot))})}); awardCards.forEach((card)=>card.addEventListener('click',()=>setAwardFocus(Number(card.dataset.awardIndex))));
  awardCarousel?.addEventListener('keydown',(event)=>{if(event.key==='ArrowLeft'){event.preventDefault();setAwardFocus(awardFocus-1)}else if(event.key==='ArrowRight'){event.preventDefault();setAwardFocus(awardFocus+1)}else if(event.key==='Escape')awardDialog?.close()});
  awardCarousel?.addEventListener('wheel',(event)=>{event.preventDefault();clearTimeout(awardWheelTimer);awardWheelTimer=setTimeout(()=>setAwardFocus(awardFocus+(event.deltaY>0||event.deltaX>0?1:-1)),45)},{passive:false});
  awardCarousel?.addEventListener('pointerdown',(event)=>{awardDrag={x:event.clientX,id:event.pointerId,moved:false,captured:false}}); awardCarousel?.addEventListener('pointermove',(event)=>{if(!awardDrag)return;if(!awardDrag.moved&&Math.abs(event.clientX-awardDrag.x)>18){awardDrag.moved=true;awardDrag.captured=true;awardCarousel.setPointerCapture?.(awardDrag.id)}}); awardCarousel?.addEventListener('pointerup',(event)=>{if(!awardDrag)return;const delta=event.clientX-awardDrag.x;if(awardDrag.moved)setAwardFocus(awardFocus+(delta<0?1:-1));if(awardDrag.captured)awardCarousel.releasePointerCapture?.(awardDrag.id);awardDrag=null}); awardCarousel?.addEventListener('pointercancel',()=>{awardDrag=null}); layoutAwards();
  const willowCanvas = document.querySelector('#willow-canvas');
  const willowContext = willowCanvas?.getContext('2d');
  const WILLOW = { interactionRadius:130, repulsionStrength:18, springStrength:.035, damping:.88, neighbourStrength:.08 };
  let willowBranches = []; let willowParticles = []; let willowWidth = 0; let willowHeight = 0; let willowDpr = 1;
  const willowPointer = { x:0, y:0, active:false, lastX:0, lastY:0, dx:0, dy:0, speed:0 };
  const createWillow = () => {
