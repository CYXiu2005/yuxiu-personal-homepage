    });
  };
  const updateWillowPointer = (clientX, clientY) => {
    if (!willowCanvas) return; const rect = willowCanvas.getBoundingClientRect();
    const x = clientX - rect.left; const y = clientY - rect.top; const inside = x >= 0 && x <= rect.width && y >= 0 && y <= rect.height;
    const wasActive = willowPointer.active; willowPointer.dx = wasActive ? x - willowPointer.lastX : 0; willowPointer.dy = wasActive ? y - willowPointer.lastY : 0;
    willowPointer.speed = Math.min(30, Math.hypot(willowPointer.dx, willowPointer.dy)); willowPointer.lastX = x; willowPointer.lastY = y; willowPointer.x = x; willowPointer.y = y; willowPointer.active = inside;
    if (inside && !reduced.matches && willowPointer.speed > 5 && Math.random() < .28) willowParticles.push({ x, y, vx:(Math.random()-.5)*.45, vy:-.12-Math.random()*.25, life:1, char:['·','0','1','叶'][Math.floor(Math.random()*4)] });
