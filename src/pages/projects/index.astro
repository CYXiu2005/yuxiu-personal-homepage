  const layoutAwards = () => {
    awardCards.forEach((card, i) => { if(card.dataset.exiting==='true'){card.style.transform='translate(-50%,-50%) translateX(-260px) translateZ(90px) rotateY(-7deg) scale(1.1)';card.style.opacity='0';card.style.filter='brightness(.72) blur(10px)';card.style.boxShadow='-24px 34px 72px -18px rgba(0,0,0,.7)';card.style.zIndex='2400';card.style.pointerEvents='none';card.setAttribute('aria-hidden','true');return} const distance=(i-awardFocus+awardCards.length)%awardCards.length; const shown=distance<=4; const tx=distance*150; const tz=-distance*175; const ry=distance*12; const scale=1-Math.min(distance*.055,.22); card.style.transform=`translate(-50%,-50%) translateX(${tx}px) translateZ(${tz}px) rotateY(${ry}deg) scale(${scale})`;card.style.opacity=shown?String(Math.max(.13,1-distance*.18)):'0';card.style.filter=`brightness(${Math.max(.38,1-distance*.17)}) blur(${Math.min(4.5,distance*.78)}px)`;card.style.boxShadow=distance===0?'0 32px 64px -22px rgba(0,0,0,.62),0 10px 24px -12px rgba(0,0,0,.48)':`18px 26px ${36+distance*11}px -12px rgba(0,0,0,${Math.min(.78,.4+distance*.09)})`;card.style.zIndex=String(2200-distance*30);card.style.pointerEvents=distance===0?'auto':'none';card.setAttribute('aria-hidden',distance===0?'false':'true'); });
