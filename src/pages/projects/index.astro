<body>
  <MessageBoardLink />
  <SiteNavigation current="projects" />
<main class="page">
  <div class="bg" aria-hidden="true">
    {frames.map((frame, i) => <img class={`bg-frame${i === 0 ? ' on' : ''}`} src={frame.src} alt="" />)}
  </div>
  <div class="willow-awards" aria-hidden="true"><canvas id="willow-canvas"></canvas></div>
  <ul class="sr-only" aria-label="获奖经历">{awards.map((award) => <li>{award}</li>)}</ul>
  <SplashCursor client:load RAINBOW_MODE={false} COLOR="#fff8df" SECONDARY_COLOR="#ffffff" COLOR_INTENSITY={0.24} SPLAT_RADIUS={0.32} DENSITY_DISSIPATION={1.8} VELOCITY_DISSIPATION={1.2} />
  <section class="layout"><div class="column">
    <header class="heading"><p class="en">Selected Project Notes</p><div class="title-line"><h1>山不让尘，川不辞盈</h1><img class="heading-seal" src="/images/home/home-bg-yin.webp" alt="云岫印" /></div><p class="note" aria-label="六则实践，点击纸页展开详情">{[...'六则实践，点击纸页展开详情'].map((char, i) => <span aria-hidden="true" style={`--i:${i};--drop-x:${(i % 3 - 1) * 7}px;--drop-rotate:${i % 2 === 0 ? -7 : 7}deg`}>{char}</span>)}</p></header>
    <div class="list">
      {projects.map((project, i) => (
        <button class="card" data-i={i} type="button">
          <span class="num">{project.n}</span>
