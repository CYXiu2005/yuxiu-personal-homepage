  };
  const setAwardFocus = (index) => { const next=normalizeAward(index);if(next===awardFocus){layoutAwards();return}const previous=awardFocus;const forward=next===normalizeAward(previous+1);const exiting=awardCards[previous];if(forward&&exiting){clearTimeout(exiting._awardExitTimer);exiting.dataset.exiting='true'}awardFocus=next;layoutAwards();if(forward&&exiting){exiting._awardExitTimer=setTimeout(()=>{delete exiting.dataset.exiting;layoutAwards()},760)} };
